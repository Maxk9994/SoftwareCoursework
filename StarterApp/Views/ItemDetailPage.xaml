<ContentPage
    x:Class="StarterApp.Views.ItemDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Item Details">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="{Binding Item.Title}"
                FontSize="26"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Item.Category}"
                FontSize="16"
                TextColor="Gray" />

            <Label
                Text="{Binding Item.DailyRate, StringFormat='£{0:F2} per day'}"
                FontSize="20"
                FontAttributes="Bold" />

            <BoxView HeightRequest="1" />

            <Label
                Text="Description"
                FontSize="18"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Item.Description}"
                FontSize="16"
                LineBreakMode="WordWrap" />

            <Button
                Text="Request Rental"
                Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>