<ContentPage
    x:Class="StarterApp.Views.ItemDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Item Details">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label
                Text="{Binding Item.Title}"
                FontSize="26"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Item.Category}"
                FontSize="16"
                TextColor="Gray" />

            <Label
                Text="{Binding Item.DailyRate, StringFormat='£{0:F2} per day'}"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Item.IsAvailable, StringFormat='Available: {0}'}"
                FontSize="15" />

            <BoxView HeightRequest="1" />

            <Label
                Text="Owner"
                FontSize="18"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Item.OwnerName, StringFormat='Listed by: {0}'}"
                FontSize="15" />

            <Label
                Text="{Binding Item.OwnerRating, StringFormat='Owner rating: {0:F1}/5'}"
                FontSize="15" />

            <BoxView HeightRequest="1" />

            <Label
                Text="Item Rating"
                FontSize="18"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Item.AverageRating, StringFormat='Average rating: {0:F1}/5'}"
                FontSize="15" />

            <BoxView HeightRequest="1" />

            <Label
                Text="Listed"
                FontSize="18"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Item.CreatedAt, StringFormat='Listed on: {0:dd MMM yyyy}'}"
                FontSize="15" />

            <BoxView HeightRequest="1" />

            <Label
                Text="Description"
                FontSize="18"
                FontAttributes="Bold" />

            <Label
                Text="{Binding Item.Description}"
                FontSize="16"
                LineBreakMode="WordWrap" />
            <Button
                Text="Edit Item"
                IsVisible="{Binding IsOwner}"
                Command="{Binding EditItemCommand}"
                Margin="0,20,0,0" />

            <Button
                Text="Request Rental"
                IsVisible="{Binding CanRequestRental}"
                Command="{Binding RequestRentalCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>