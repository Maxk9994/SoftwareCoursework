<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StarterApp.Views.RentalsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Rental Requests">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Button
                Text="Refresh Rentals"
                Command="{Binding LoadRentalsCommand}" />

            <Label
                Text="{Binding ErrorMessage}"
                TextColor="Red" />

            <Label
                Text="Incoming Requests"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Label
                Text="Requests from other users for items you own"
                FontSize="13"
                TextColor="Gray" />

            <CollectionView ItemsSource="{Binding IncomingRentals}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding ItemTitle}"
                                    FontAttributes="Bold"
                                    FontSize="18" />

                                <Label
                                    Text="{Binding BorrowerName, StringFormat='Borrower: {0}'}" />

                                <Label
                                    Text="{Binding Status, StringFormat='Status: {0}'}" />

                                <Label
                                    Text="{Binding StartDate, StringFormat='Start: {0:dd MMM yyyy}'}" />

                                <Label
                                    Text="{Binding EndDate, StringFormat='End: {0:dd MMM yyyy}'}" />

                                <Label
                                    Text="{Binding TotalPrice, StringFormat='Total: £{0:F2}'}"
                                    FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                Text="Outgoing Requests"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,20,0,0" />

            <Label
                Text="Requests you have made to rent other users' items"
                FontSize="13"
                TextColor="Gray" />

            <CollectionView ItemsSource="{Binding OutgoingRentals}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding ItemTitle}"
                                    FontAttributes="Bold"
                                    FontSize="18" />

                                <Label
                                    Text="{Binding OwnerName, StringFormat='Owner: {0}'}" />

                                <Label
                                    Text="{Binding Status, StringFormat='Status: {0}'}" />

                                <Label
                                    Text="{Binding StartDate, StringFormat='Start: {0:dd MMM yyyy}'}" />

                                <Label
                                    Text="{Binding EndDate, StringFormat='End: {0:dd MMM yyyy}'}" />

                                <Label
                                    Text="{Binding TotalPrice, StringFormat='Total: £{0:F2}'}"
                                    FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>